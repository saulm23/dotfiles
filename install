install packages
clone dotfiles
link dotfiles
setup vim and docs to learn

mkdir .config
mkdir .config/kitty
mkdir .config/picom
mkdir .config/i3
mkdir .config/i3status



ln -s -T ~/dotfiles/i3/config config
ln -s -T ~/dotfiles/kitty/kitty.conf kitty.conf
ln -s -T ~/dotfiles/kitty/current-theme.conf current-theme.conf
echo exec i3 >> xinit
ln -s -T ~/dotfiles/xinit .xinitrc
ln -s -T ~/dotfiles/i3status/config config
ln -s -T ~/dotfiles/i3status/config ~/.config/i3status/config
ln -s -T ~/dotfiles/vim ~/.vimrc
cd
rm .bashrc
ln -s -T ~/dotfiles/bash ~/.bashrc
sudo pacman -S --needed git base-devel && git clone https://aur.archlinux.org/yay.git && cd yay && makepkg -si

